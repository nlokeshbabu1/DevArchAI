# Frontend Environment Variables
# Copy this file to .env and update with your production values
# NEVER commit .env with real values to version control

# ===========================================
# API Configuration
# ===========================================
# Production: Set to your backend API URL
VITE_API_URL=https://api.devarchai.com
VITE_API_TIMEOUT=30000

# ===========================================
# React Query Configuration
# ===========================================
VITE_QUERY_RETRY=2
VITE_QUERY_REFETCH_ON_FOCUS=false
VITE_QUERY_STALE_TIME=300000
VITE_QUERY_CACHE_TIME=600000

# ===========================================
# Polling Intervals (milliseconds)
# ===========================================
VITE_SCAN_HISTORY_POLL_INTERVAL=3000
VITE_REPOSITORIES_POLL_INTERVAL=5000
VITE_FINDINGS_POLL_INTERVAL=5000
VITE_DASHBOARD_POLL_INTERVAL=10000
VITE_SCAN_POLL_INTERVAL=1000
VITE_SCAN_TIMEOUT=60000

# ===========================================
# Animation/UX Delays (milliseconds)
# ===========================================
VITE_MIN_ANIMATION_DURATION=15000
VITE_COPY_FEEDBACK_DURATION=2000
VITE_TOAST_DURATION=2000
VITE_REDIRECT_DELAY=1000

# ===========================================
# Pagination
# ===========================================
VITE_DEFAULT_PAGE_SIZE=20
VITE_FINDINGS_PAGE_SIZE=100

# ===========================================
# GitHub OAuth
# ===========================================
# Get this from https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_OAUTH_SCOPE=user:email read:user
# GitHub OAuth redirect URI (must match GitHub OAuth App settings)
VITE_GITHUB_REDIRECT_URI=http://localhost/auth/github/callback

# ===========================================
# External Services
# ===========================================
VITE_IPAPI_URL=https://ipapi.co/json/

# ===========================================
# Documentation URLs
# ===========================================
VITE_DOCS_BASE_URL=https://docs.devarchai.com
VITE_K8S_DOCS_URL=https://kubernetes.io/docs
VITE_DOCKER_DOCS_URL=https://docs.docker.com
VITE_TERRAFORM_DOCS_URL=https://developer.hashicorp.com/terraform
VITE_GITHUB_DOCS_URL=https://docs.github.com

# ===========================================
# Features
# ===========================================
VITE_ENABLE_MOCK_AUTH=false
VITE_MOCK_USER_PLAN=free

# ===========================================
# Stripe (for production - publishable key only)
# ===========================================
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ===========================================
# Sentry (optional - for error tracking)
# ===========================================
# Get from https://sentry.io/settings/your-org/projects/
VITE_SENTRY_DSN=

# ===========================================
# Analytics (optional)
# ===========================================
VITE_ANALYTICS_ID=

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Update VITE_API_URL with your production backend URL
# 3. Set VITE_GITHUB_REDIRECT_URI to match your GitHub OAuth App settings
# 4. Add VITE_GITHUB_CLIENT_ID if using GitHub OAuth
# 5. Add VITE_STRIPE_PUBLISHABLE_KEY for billing features
# 6. Add VITE_SENTRY_DSN for error tracking (optional)
# 7. Build for production: npm run build
# 8. Deploy the dist/ folder to your hosting service

# ===========================================
# END OF TEMPLATE
# ===========================================
