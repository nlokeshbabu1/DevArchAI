# ===========================================
# DevArchAI - Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# 1. APPLICATION SETTINGS
# ===========================================
APP_NAME=DevArchAI
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# ===========================================
# 2. SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=8000

# ===========================================
# 3. CORS & SECURITY
# ===========================================
# Production: Update with your actual frontend domain(s)
CORS_ORIGINS=["https://devarchai.com","https://www.devarchai.com"]
ALLOWED_HOSTS=["*"]
FRONTEND_URL=https://devarchai.com

# ===========================================
# 4. DATABASE CONFIGURATION
# ===========================================
# Production: Use environment-specific connection string
DATABASE_URL=postgresql+asyncpg://user:password@host:port/devarchai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ===========================================
# 5. REDIS CONFIGURATION
# ===========================================
# Production: Use your Redis service credentials
REDIS_URL=redis://user:password@host:port/0
CELERY_BROKER_URL=redis://user:password@host:port/1
CELERY_RESULT_BACKEND=redis://user:password@host:port/2

# ===========================================
# 6. AWS CONFIGURATION (Optional)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=devarchai-reports

# ===========================================
# 7. LLM CONFIGURATION
# ===========================================
# Choose one: mock, openai, anthropic, gemini, mistral
LLM_PROVIDER=mock

# Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# Mistral API Key
MISTRAL_API_KEY=

LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ===========================================
# 8. GITHUB INTEGRATION
# ===========================================
GITHUB_TOKEN=

# ===========================================
# 9. GITHUB OAUTH (Optional)
# ===========================================
# Get these from https://github.com/settings/developers
# Production: Update redirect URI with production domain
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://devarchai.com/auth/github/callback

# ===========================================
# 10. ANALYSIS SETTINGS
# ===========================================
MAX_REPO_SIZE_MB=100
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=/tmp/devarchai

# ===========================================
# 11. SECURITY SETTINGS
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Must be at least 32 characters in production
SECRET_KEY=change-me-in-production-min-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# 12. RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# 13. TIMEOUT SETTINGS (seconds)
# ===========================================
GITHUB_API_TIMEOUT=10.0
GITHUB_OAUTH_TIMEOUT=10.0
GIT_CLONE_TIMEOUT=120
GIT_OPERATION_TIMEOUT=30
HTTP_REQUEST_TIMEOUT=10
TRIVY_TIMEOUT=300
CHECKOV_TIMEOUT=300
SCAN_TIMEOUT=300

# ===========================================
# 14. CELERY SETTINGS
# ===========================================
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_TIME_LIMIT=1800

# ===========================================
# 15. ANONYMOUS SCANS
# ===========================================
ANONYMOUS_SCAN_EXPIRY_HOURS=24

# ===========================================
# 16. LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Update DATABASE_URL with your production credentials
# 3. Update REDIS_URL and Celery URLs with production Redis
# 4. Set SECRET_KEY to a random string (see command above)
# 5. Update CORS_ORIGINS and FRONTEND_URL with production domain
# 6. Update GITHUB_REDIRECT_URI with production callback URL
# 7. Configure LLM_PROVIDER and add API key if using AI
# 8. Add GitHub OAuth credentials if using authentication
# 9. Set ENVIRONMENT=production and DEBUG=false
# 10. Set LOG_FORMAT=json for production logging
# 11. Run migrations: alembic upgrade head
# 12. Start server: python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

# ===========================================
# END OF TEMPLATE
# ===========================================
