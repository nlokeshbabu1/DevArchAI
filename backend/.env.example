# DevArchAI Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# ===========================================
# Application Settings
# ===========================================
APP_NAME=DevArchAI
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# ===========================================
# CORS Settings
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
ALLOWED_HOSTS=["*"]

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devarchai

# SQLite (for development/testing)
# DATABASE_URL=sqlite+aiosqlite:///./devarchai.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===========================================
# Redis Configuration (optional)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# AWS Configuration (optional)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=devarchai-reports

# ===========================================
# LLM Configuration
# ===========================================
# Options: openai, anthropic, mock
LLM_PROVIDER=mock

# OpenAI (if using OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-4-turbo-preview

# Anthropic (if using Anthropic)
ANTHROPIC_API_KEY=

# LLM Settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ===========================================
# GitHub Configuration
# ===========================================
GITHUB_TOKEN=

# ===========================================
# Analysis Settings
# ===========================================
MAX_REPO_SIZE_MB=100
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=/tmp/devarchai

# ===========================================
# Security Settings
# ===========================================
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=INFO
# Options: json (production), console (development)
LOG_FORMAT=console
