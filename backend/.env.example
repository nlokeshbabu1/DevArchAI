# Backend Environment Variables
# Copy this file to .env and update with your values
# CRITICAL: Never commit .env file to version control!

# ===========================================
# APPLICATION SETTINGS
# ===========================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5174

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devarchai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=1800

# ===========================================
# SECURITY - CRITICAL FOR PRODUCTION
# ===========================================
# GENERATE A NEW KEY FOR PRODUCTION: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters long
SECRET_KEY=change-me-in-production-use-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# GITHUB OAUTH (Optional)
# ===========================================
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5174/auth/github/callback
GITHUB_TOKEN=

# ===========================================
# LLM CONFIGURATION (Optional)
# ===========================================
LLM_PROVIDER=mock
# LLM_PROVIDER=openai  # or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ===========================================
# AWS CONFIGURATION (Optional)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=devarchai-reports

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
ALLOWED_HOSTS=["*"]

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# ANALYSIS SETTINGS
# ===========================================
MAX_REPO_SIZE_MB=100
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=/tmp/devarchai

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================
# Before deploying to production:
# [ ] Change SECRET_KEY to a long random string
# [ ] Set ENVIRONMENT=production
# [ ] Set DEBUG=false
# [ ] Update DATABASE_URL with production credentials
# [ ] Update REDIS_URL with production Redis
# [ ] Update CORS_ORIGINS with production domain
# [ ] Set ALLOWED_HOSTS to production domains
# [ ] Configure HTTPS
# [ ] Set up proper logging and monitoring
# [ ] Run database migrations
# [ ] Test all endpoints
