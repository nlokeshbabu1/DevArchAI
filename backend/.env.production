# ===========================================
# DevArchAI - Production Environment Configuration
# ===========================================
# Copy this file to .env and update values for production
# NEVER commit .env to version control!

# ===========================================
# 1. APPLICATION SETTINGS
# ===========================================
APP_NAME=DevArchAI
VERSION=1.0.0

# CRITICAL: Set to 'production' in production environment
ENVIRONMENT=production
DEBUG=false

# ===========================================
# 2. SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=8000

# ===========================================
# 3. CORS & SECURITY
# ===========================================
# Update with your production domain(s)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com","https://app.yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com","www.yourdomain.com","app.yourdomain.com"]

# Your production frontend URL
FRONTEND_URL=https://app.yourdomain.com

# ===========================================
# 4. DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:strong_password_here@localhost:5432/devarchai

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ===========================================
# 5. REDIS CONFIGURATION (Required for Celery)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# Celery broker (Redis)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=1800

# ===========================================
# 6. AWS CONFIGURATION (For S3 Report Storage)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=your-production-bucket-name

# ===========================================
# 7. LLM CONFIGURATION (AI Provider)
# ===========================================
# Choose ONE provider: 'mock', 'openai', 'anthropic', or 'gemini'
# For production, recommend: gemini or openai

LLM_PROVIDER=gemini

# --- Option A: Google Gemini (Recommended for production) ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-pro

# --- Option B: OpenAI (Alternative) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# LLM_MODEL=gpt-4-turbo-preview

# --- Option C: Anthropic Claude (Alternative) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_MODEL=claude-3-sonnet-20240229

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ===========================================
# 8. GITHUB INTEGRATION
# ===========================================
# GitHub Personal Access Token (for scanning private repos)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# ===========================================
# 9. GITHUB OAUTH (For User Authentication)
# ===========================================
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://app.yourdomain.com/auth/github/callback

# ===========================================
# 10. ANALYSIS SETTINGS
# ===========================================
MAX_REPO_SIZE_MB=100
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=/tmp/devarchai

# ===========================================
# 11. SECURITY (CRITICAL FOR PRODUCTION)
# ===========================================
# GENERATE A NEW RANDOM KEY FOR PRODUCTION!
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_super_long_random_secret_key_min_48_chars_here

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# 12. RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# 13. LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# 14. OPTIONAL: EMAIL CONFIGURATION
# ===========================================
# For sending notifications, password resets, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# 15. OPTIONAL: MONITORING & OBSERVABILITY
# ===========================================
# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456

# Prometheus metrics
# ENABLE_METRICS=true
# METRICS_PORT=9090

# ===========================================
# 16. OPTIONAL: FEATURE FLAGS
# ===========================================
# ENABLE_ANALYTICS=true
# ENABLE_BILLING=true
# ENABLE_WEBHOOKS=true

# ===========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ===========================================
# [ ] Set ENVIRONMENT=production
# [ ] Set DEBUG=false
# [ ] Update CORS_ORIGINS with your domain
# [ ] Update FRONTEND_URL
# [ ] Generate new SECRET_KEY (min 48 chars)
# [ ] Set strong DATABASE_URL password
# [ ] Configure AWS credentials (if using S3)
# [ ] Set LLM provider API key
# [ ] Configure GitHub OAuth credentials
# [ ] Set GITHUB_TOKEN for private repo scanning
# [ ] Configure Redis (required for Celery)
# [ ] Set up SSL/TLS certificates
# [ ] Configure firewall rules
# [ ] Set up log aggregation (e.g., ELK, Splunk)
# [ ] Configure backup strategy for database
# [ ] Set up monitoring and alerting
# ===========================================
